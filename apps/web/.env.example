# Copy to .env and fill in your values.

# PostgreSQL local (p. ej. Homebrew postgresql@17). Nunca la URL de produccion:
# Vercel inyecta la suya propia desde Storage.
DATABASE_URL="postgresql://user@localhost:5432/gastos_dev"

# Auth.js — generate with: openssl rand -base64 33
AUTH_SECRET="change-me"

# Initial admin user created by the seed (prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
